---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  eyebrow?: string;
  pageTitle?: string;
}

const { title, description, image, eyebrow, pageTitle = title } = Astro.props;
---

<BaseLayout title={pageTitle} description={description} image={image}>
  <article class="prose-page">
    <header class="prose-header container-site">
      {eyebrow && <p class="label-mono">{eyebrow}</p>}
      <h1 class="text-heading-1">{title}</h1>
      <p class="lede">{description}</p>
    </header>
    <div class="prose-body container-site">
      <div class="prose-narrow prose-content">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .prose-page {
    padding-block: var(--space-9) var(--space-10);
  }

  .prose-header {
    margin-bottom: var(--space-8);
    max-width: 48rem;
  }

  .prose-header .label-mono {
    margin-bottom: var(--space-4);
  }

  .lede {
    margin-top: var(--space-5);
    color: var(--color-text-secondary);
    font-size: var(--text-body-lg);
    line-height: 1.7;
    max-width: 40rem;
  }

  .prose-content :global(h2) {
    font-family: var(--font-display);
    font-size: var(--text-heading-3);
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
    line-height: 1.15;
  }

  .prose-content :global(h3) {
    font-family: var(--font-display);
    font-size: 1.35rem;
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
  }

  .prose-content :global(p),
  .prose-content :global(ul),
  .prose-content :global(ol) {
    margin-bottom: var(--space-5);
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .prose-content :global(ul),
  .prose-content :global(ol) {
    padding-left: 1.25rem;
  }

  .prose-content :global(ul) {
    list-style-type: disc;
  }

  .prose-content :global(ol) {
    list-style-type: decimal;
  }

  .prose-content :global(li) {
    margin-bottom: var(--space-2);
    padding-left: 0.15rem;
  }

  .prose-content :global(li::marker) {
    color: var(--color-text-muted);
  }

  .prose-content :global(a) {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--color-border-strong);
  }

  .prose-content :global(a:hover) {
    text-decoration-color: var(--color-text-primary);
  }

  .prose-content :global(strong) {
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .prose-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-text-primary);
    background: var(--color-surface);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
  }

  .prose-content :global(blockquote) {
    margin: var(--space-7) 0;
    padding-left: var(--space-5);
    border-left: 1px solid var(--color-border-strong);
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: var(--text-heading-3);
    line-height: 1.3;
  }
</style>
