---
import { Image } from 'astro:assets';
import heroPortrait from '../assets/images/hero-portrait.jpg';
import { site } from '../data/site';
---

<section class="hero" aria-label="Introduction">
  <div class="hero__media" aria-hidden="true">
    <Image
      class="img-mono"
      src={heroPortrait}
      alt=""
      widths={[720, 1080, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      quality={82}
    />
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="hero__content container-site">
    <div class="hero__copy">
      <p class="label-mono">{site.role}</p>
      <h1 class="hero__body">{site.positioning}</h1>
    </div>

    <a class="hero__teaser" href="#identity" aria-label="Scroll to identity">
      <span class="hero__teaser-text">I am…</span>
      <span class="hero__teaser-hint" aria-hidden="true"></span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: stretch;
    /* First screen under the sticky header */
    min-height: calc(100svh - 64px);
    height: calc(100svh - 64px);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: #0b0b0c;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: 58% 18%;
  }

  /* Strong left/top wash so off-white type stays readable on the photo */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        90deg,
        rgba(8, 9, 11, 0.82) 0%,
        rgba(8, 9, 11, 0.55) 34%,
        rgba(8, 9, 11, 0.22) 58%,
        rgba(8, 9, 11, 0.12) 100%
      ),
      linear-gradient(
        180deg,
        rgba(8, 9, 11, 0.72) 0%,
        rgba(8, 9, 11, 0.18) 42%,
        rgba(8, 9, 11, 0.08) 68%,
        rgba(8, 9, 11, 0.55) 100%
      );
  }

  .hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block: clamp(2rem, 6vh, 4rem) clamp(1.75rem, 4vh, 3rem);
  }

  .hero__copy {
    max-width: 34rem;
    padding-top: clamp(0.5rem, 2vh, 1.25rem);
  }

  .hero__copy .label-mono {
    margin-bottom: var(--space-4);
    color: rgba(242, 242, 242, 0.72);
  }

  .hero__body {
    margin: var(--space-5) 0 0;
    font-family: var(--font-body);
    font-weight: 400;
    color: rgba(242, 242, 242, 0.82);
    font-size: clamp(0.95rem, 1.25vw, 1.1rem);
    line-height: 1.7;
    max-width: 38ch;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.3);
  }

  .hero__teaser {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    width: fit-content;
    text-decoration: none;
    color: rgba(242, 242, 242, 0.88);
    transition: color 200ms ease, opacity 200ms ease;
  }

  .hero__teaser:hover,
  .hero__teaser:focus-visible {
    color: #f2f2f2;
  }

  .hero__teaser-text {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.2vw, 2.25rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.35);
  }

  .hero__teaser-hint {
    width: 0.65rem;
    height: 0.65rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    opacity: 0.7;
    animation: teaser-bob 1.8s ease-in-out infinite;
  }

  @keyframes teaser-bob {
    0%,
    100% {
      transform: rotate(45deg) translateY(-3px);
      opacity: 0.45;
    }
    50% {
      transform: rotate(45deg) translateY(2px);
      opacity: 0.9;
    }
  }

  @media (max-width: 1100px) {
    .hero__media img {
      object-position: 55% 14%;
    }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: calc(100svh - 64px);
      height: calc(100svh - 64px);
    }

    .hero__media img {
      object-position: 52% 10%;
    }

    .hero__overlay {
      background:
        linear-gradient(
          180deg,
          rgba(8, 9, 11, 0.78) 0%,
          rgba(8, 9, 11, 0.28) 38%,
          rgba(8, 9, 11, 0.2) 70%,
          rgba(8, 9, 11, 0.72) 100%
        ),
        linear-gradient(
          90deg,
          rgba(8, 9, 11, 0.55) 0%,
          rgba(8, 9, 11, 0.25) 100%
        );
    }

    .hero__copy {
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__teaser-hint {
      animation: none;
    }
  }
</style>
