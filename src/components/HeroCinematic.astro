---
import { Image } from 'astro:assets';
import heroPortrait from '../assets/images/hero-portrait.jpg';
import { site } from '../data/site';
---

<section class="hero" aria-label="Introduction">
  <div class="hero__inner container-site">
    <div class="hero__copy">
      <p class="label-mono">{site.role}</p>
      <h1 class="hero__title">{site.tagline}</h1>
      <p class="hero__body">{site.positioning}</p>
    </div>

    <div class="hero__media">
      <Image
        class="img-mono"
        src={heroPortrait}
        alt="Tiaan Viviers in a suit at a chessboard"
        widths={[640, 960, 1280]}
        sizes="(max-width: 900px) 100vw, 50vw"
        loading="eager"
        fetchpriority="high"
        quality={80}
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2rem, 5vh, 4rem) clamp(2.5rem, 6vh, 4.5rem);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: stretch;
    gap: clamp(1.75rem, 4vw, 4rem);
    min-height: clamp(420px, 68vh, 640px);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-self: start;
    max-width: 32rem;
    padding-block: 0;
  }

  .hero__copy .label-mono {
    margin-bottom: var(--space-4);
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.4vw, 3rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
  }

  .hero__body {
    margin: var(--space-5) 0 0;
    color: var(--color-text-secondary);
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    line-height: 1.7;
    max-width: 36ch;
  }

  .hero__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    min-height: 0;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: 58% 48%;
    /* Crop ~12% from top and bottom (and a little from the sides) */
    transform: scale(1.28);
    transform-origin: 58% 48%;
  }

  @media (max-width: 1100px) {
    .hero__inner {
      min-height: clamp(380px, 62vh, 560px);
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }

    .hero__media img {
      object-position: 55% 46%;
      transform-origin: 55% 46%;
    }
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
      min-height: unset;
      gap: var(--space-5);
    }

    .hero__copy {
      order: 2;
      max-width: 100%;
    }

    .hero__media {
      order: 1;
      aspect-ratio: 4 / 5;
      max-height: 70vh;
    }

    .hero__media img {
      object-position: 52% 44%;
      transform-origin: 52% 44%;
      transform: scale(1.22);
    }
  }
</style>
