---
import { Image } from 'astro:assets';
import heroPortrait from '../assets/images/hero-portrait.jpg';
import { site } from '../data/site';
---

<section class="hero" aria-label="Introduction">
  <div class="hero__media" aria-hidden="true">
    <Image
      class="img-mono"
      src={heroPortrait}
      alt=""
      widths={[720, 1080, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      quality={82}
    />
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="hero__content container-site">
    <div class="hero__copy">
      <p class="label-mono">{site.role}</p>
      <h1 class="hero__title">{site.tagline}</h1>
      <p class="hero__body">{site.positioning}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    /* First screen under the sticky header */
    min-height: calc(100svh - 64px);
    height: calc(100svh - 64px);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: #0b0b0c;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: 58% 18%;
  }

  /* Strong left/bottom wash so off-white type stays readable on the photo */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        90deg,
        rgba(8, 9, 11, 0.82) 0%,
        rgba(8, 9, 11, 0.55) 34%,
        rgba(8, 9, 11, 0.22) 58%,
        rgba(8, 9, 11, 0.12) 100%
      ),
      linear-gradient(
        180deg,
        rgba(8, 9, 11, 0.28) 0%,
        rgba(8, 9, 11, 0.08) 35%,
        rgba(8, 9, 11, 0.72) 100%
      );
  }

  .hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block: clamp(2rem, 6vh, 4rem);
  }

  .hero__copy {
    max-width: 34rem;
  }

  .hero__copy .label-mono {
    margin-bottom: var(--space-4);
    color: rgba(242, 242, 242, 0.72);
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.2vw, 3.5rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #f2f2f2;
    text-shadow: 0 1px 24px rgba(0, 0, 0, 0.35);
  }

  .hero__body {
    margin: var(--space-5) 0 0;
    color: rgba(242, 242, 242, 0.82);
    font-size: clamp(0.95rem, 1.25vw, 1.1rem);
    line-height: 1.7;
    max-width: 38ch;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.3);
  }

  @media (max-width: 1100px) {
    .hero__media img {
      object-position: 55% 14%;
    }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: calc(100svh - 64px);
      height: calc(100svh - 64px);
      align-items: flex-end;
    }

    .hero__media img {
      object-position: 52% 10%;
    }

    .hero__overlay {
      background:
        linear-gradient(
          180deg,
          rgba(8, 9, 11, 0.35) 0%,
          rgba(8, 9, 11, 0.2) 40%,
          rgba(8, 9, 11, 0.88) 100%
        ),
        linear-gradient(
          90deg,
          rgba(8, 9, 11, 0.55) 0%,
          rgba(8, 9, 11, 0.25) 100%
        );
    }

    .hero__copy {
      max-width: 100%;
    }
  }
</style>
