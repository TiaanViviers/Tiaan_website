---
interface Props {
  title?: string;
  items: { label: string; text: string }[];
}

const { title = 'Now', items } = Astro.props;
---

<section class="now-section reveal" aria-labelledby="now-heading">
  <p class="label-mono">{title}</p>
  <h2 id="now-heading" class="visually-hidden">Current focus</h2>
  <ul>
    {
      items.map((item) => (
        <li>
          <span class="label-mono">{item.label}</span>
          <p>{item.text}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .now-section {
    padding: var(--space-7);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .now-section > .label-mono {
    margin-bottom: var(--space-5);
  }

  .now-section ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
  }

  .now-section li {
    display: grid;
    gap: var(--space-2);
  }

  .now-section p {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
