---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  objectPosition?: string;
  aspect?: string;
}

const {
  src,
  alt,
  caption,
  objectPosition = 'center',
  aspect = '4 / 5',
} = Astro.props;
---

<figure class="image-panel">
  <div class="image-panel__frame" style={`aspect-ratio: ${aspect}`}>
    <img
      class="img-mono"
      src={src}
      alt={alt}
      loading="lazy"
      decoding="async"
      style={`object-position: ${objectPosition}`}
    />
  </div>
  {caption && <figcaption class="label-mono">{caption}</figcaption>}
</figure>

<style>
  .image-panel {
    margin: 0;
  }

  .image-panel__frame {
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .image-panel__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .image-panel:hover .image-panel__frame img {
    transform: scale(1.02);
  }

  figcaption {
    margin-top: var(--space-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .image-panel__frame img {
      transition: none;
    }

    .image-panel:hover .image-panel__frame img {
      transform: none;
    }
  }
</style>
