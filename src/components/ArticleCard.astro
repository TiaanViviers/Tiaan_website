---
interface Props {
  title: string;
  description: string;
  href: string;
  date: string;
  tags?: string[];
}

const { title, description, href, date, tags = [] } = Astro.props;
---

<article class="article-card reveal">
  <a class="article-card__link" href={href}>
    <p class="label-mono">{date}</p>
    <h3 class="article-card__title">{title}</h3>
    <p class="article-card__desc">{description}</p>
    {
      tags.length > 0 && (
        <p class="article-card__tags label-mono">{tags.slice(0, 3).join('  /  ')}</p>
      )
    }
  </a>
</article>

<style>
  .article-card {
    border-top: 1px solid var(--color-border);
  }

  .article-card:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .article-card__link {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-2);
    transition: background var(--duration-base) var(--ease-out);
  }

  .article-card__link:hover {
    background: var(--color-surface);
  }

  .article-card__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    line-height: 1.15;
    color: var(--color-text-primary);
  }

  .article-card__desc {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    line-height: 1.65;
    max-width: 52ch;
  }

  .article-card__tags {
    margin: 0;
  }
</style>
