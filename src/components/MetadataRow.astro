---
interface Props {
  items: { label: string; value: string }[];
}

const { items } = Astro.props;
---

<dl class="metadata-row">
  {
    items.map((item) => (
      <div class="metadata-row__item">
        <dt class="label-mono">{item.label}</dt>
        <dd>{item.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .metadata-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin: 0;
  }

  .metadata-row__item {
    display: grid;
    gap: var(--space-2);
  }

  .metadata-row__item dd {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-small);
  }
</style>
