---
interface Props {
  eyebrow: string;
  title: string;
  body: string;
  image: string;
  imageAlt: string;
  imagePosition?: string;
  reverse?: boolean;
}

const {
  eyebrow,
  title,
  body,
  image,
  imageAlt,
  imagePosition = '50% 50%',
  reverse = false,
} = Astro.props;
---

<section
  class:list={['identity-panel', { 'identity-panel--reverse': reverse }]}
  style={`--image-position: ${imagePosition}`}
  data-identity-panel
>
  <div class="identity-image">
    <img class="img-mono" src={image} alt={imageAlt} loading="lazy" decoding="async" />
  </div>
  <div class="identity-copy">
    <p class="eyebrow label-mono">{eyebrow}</p>
    <h2>{title}</h2>
    <p>{body}</p>
  </div>
</section>

<style>
  .identity-panel {
    min-height: 90svh;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 7rem);
    padding-block: clamp(4rem, 9vh, 8rem);
  }

  .identity-panel--reverse {
    grid-template-columns: minmax(280px, 0.85fr) minmax(0, 1.15fr);
  }

  .identity-panel--reverse .identity-image {
    order: 2;
  }

  .identity-panel--reverse .identity-copy {
    order: 1;
  }

  .identity-image {
    height: min(72svh, 760px);
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .identity-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: var(--image-position, 50% 50%);
  }

  .identity-copy {
    max-width: 28rem;
  }

  .identity-copy .eyebrow {
    margin: 0 0 var(--space-4);
  }

  .identity-copy h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
  }

  .identity-copy p:last-child {
    margin: var(--space-4) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--text-body-lg);
    line-height: 1.7;
  }

  .identity-image,
  .identity-copy {
    opacity: 0;
    transform: translateY(32px);
    transition:
      opacity 700ms ease,
      transform 900ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .identity-image {
    transform: translateY(32px) translateX(-36px);
  }

  .identity-copy {
    transform: translateY(32px) translateX(36px);
  }

  .identity-panel--reverse .identity-image {
    transform: translateY(32px) translateX(36px);
  }

  .identity-panel--reverse .identity-copy {
    transform: translateY(32px) translateX(-36px);
  }

  .identity-panel.is-visible .identity-image,
  .identity-panel.is-visible .identity-copy {
    opacity: 1;
    transform: translateY(0) translateX(0);
  }

  @media (max-width: 900px) {
    .identity-panel,
    .identity-panel--reverse {
      grid-template-columns: 1fr;
      min-height: unset;
      gap: var(--space-5);
      padding-block: var(--space-8);
    }

    .identity-panel--reverse .identity-image,
    .identity-panel--reverse .identity-copy {
      order: unset;
    }

    .identity-image {
      height: auto;
      aspect-ratio: 4 / 5;
      max-height: 70vh;
    }

    .identity-image,
    .identity-copy,
    .identity-panel--reverse .identity-image,
    .identity-panel--reverse .identity-copy {
      transform: translateY(28px);
    }

    .identity-panel.is-visible .identity-image,
    .identity-panel.is-visible .identity-copy {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .identity-image,
    .identity-copy {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
