---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title={`About — ${site.name}`}
  description="Data Science student at Stellenbosch University — interested where statistics becomes a model inside a real system, solving a real problem."
>
  <section class="about container-site">
    <div class="about__grid">
      <div class="about__left">
        <header class="about__header">
          <p class="label-mono">About</p>
          <h1 class="about__title">{site.name}</h1>
          <p class="about__lede">
            I’m interested in the point where statistics stops being 
            theory and has to become something useful; a model inside a real
            system, solving a real problem.
          </p>
        </header>

        <figure class="about__photo">
          <img
            class="img-mono"
            src="/images/hero-portrait.jpg"
            alt="Tiaan Viviers in a suit at a chessboard"
            width="1277"
            height="1536"
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>

      <div class="about__copy">
        <h2>My Passion</h2>
        <p>
          I get energised by unusual problems that make you stop and think. My best work happens in
          a team where curiosity and ambition feed off one another: ideas are challenged, people
          become invested, and there is that shared moment when a solution finally starts coming
          together.
        </p>
        <p>
          I value the mathematics, statistics, and careful reasoning behind data science, but I
          naturally lean toward the engineering side of the field. I do not want the work to end in
          a notebook. I enjoy turning an idea into a complete system or product: designing the
          pipeline around it, making the trade-offs explicit, testing whether it holds up, and
          building something people can use.
        </p>

        <h2>Outside the work</h2>
        <p>
          Away from the screen, I spend a lot of time in the gym and looking for reasons to get
          outdoors, whether that means mountains, the ocean, or something slightly outside my
          comfort zone.
        </p>
        <p>
          The gym gives me somewhere to reset, work through pressure, and maintain the discipline
          and healthy routine that support everything else I do. Time outdoors serves a different
          purpose: it creates space to think, slows things down, and reminds me that not every
          worthwhile challenge happens behind a desk.
        </p>

        <h2>Currently</h2>
        <p>
          Studying Data Science at Stellenbosch University and completing my 4 year undergraduate
          degree (NQF level 8).
        </p>
        <p>
          Building research and software projects around tokenisation, online inference,
          probabilistic algorithms, and applied machine learning.
        </p>
        <p>
          Looking for bursaries, internships, research opportunities, and eventually a role where I
          can take real ownership of difficult technical problems.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    padding-block: var(--space-5) var(--space-7);
  }

  .about__grid {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }

  .about__left {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .about__header .label-mono {
    margin-bottom: var(--space-2);
  }

  .about__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3vw, 2.5rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .about__lede {
    margin: var(--space-4) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    line-height: 1.7;
  }

  .about__photo {
    margin: 0;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    overflow: hidden;
    background: var(--color-surface);
    line-height: 0;
  }

  /* Full photograph — natural proportions, no cover-crop */
  .about__photo img {
    width: 100%;
    height: auto;
    display: block;
  }

  .about__copy {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .about__copy h2 {
    margin: var(--space-3) 0 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .about__copy h2:first-child {
    margin-top: 0;
  }

  .about__copy p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    line-height: 1.7;
  }

  @media (min-width: 900px) {
    .about__grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: var(--space-8);
    }
  }
</style>

<style is:global>
  body:has(.about) .site-footer {
    margin-top: 0;
    padding-block: var(--space-5);
  }
</style>
