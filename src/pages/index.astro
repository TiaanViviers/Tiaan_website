---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCinematic from '../components/HeroCinematic.astro';
import IdentityPanel from '../components/IdentityPanel.astro';

const identities = [
  {
    title: 'Curious.',
    quote: '"I have no special talents. I am only passionately curious." — Albert Einstein',
    body: 'Curiosity is the engine behind everything I learn. It is the reason my interests span across all parts of data and software. If you give me an interesting question, I will chase it until I find the bedrock.',
    image: '/images/atmosphere/astronomy.png',
    imageAlt: 'Night sky and astronomy equipment under stars',
    imagePosition: '50% 38%',
    reverse: false,
  },
  {
    title: 'Accountable.',
    quote: '"The price of greatness is responsibility." — Winston Churchill',
    body: 'Accountability means running toward the fires, not away from them. Whether I am leading a project or supporting a teammate, my goal is to create stability where there is chaos and to always finish what I start.',
    image: '/images/atmosphere/cliff-jump.png',
    imageAlt: 'Person jumping across a mountain gap',
    imagePosition: '50% 28%',
    reverse: true,
  },
  {
    title: 'Persistent.',
    quote:
      '"I don\'t think you can overstate the amount of discipline and pain tolerance required to build something that lasts." — Jensen Huang',
    body: 'I do not expect rewarding work to feel easy. Anyone can get excited about a brand-new idea, but the real work happens when you hit a brick wall. That is where I find my stride, in the quiet, unglamorous grind.',
    image: '/images/atmosphere/mountain-explore.png',
    imageAlt: 'Hiker walking a misty mountain path',
    imagePosition: '50% 42%',
    reverse: false,
  },
];
---

<BaseLayout>
  <div class="home">
    <HeroCinematic />

    <section class="identity-intro container-site" aria-label="Identity">
      <p class="identity-intro__text">I am…</p>
    </section>

    <div class="identity-sequence container-site">
      {
        identities.map((item) => (
          <IdentityPanel
            title={item.title}
            quote={item.quote}
            body={item.body}
            image={item.image}
            imageAlt={item.imageAlt}
            imagePosition={item.imagePosition}
            reverse={item.reverse}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>

<script>
  const panels = document.querySelectorAll('[data-identity-panel]');

  const reveal = (entries: IntersectionObserverEntry[], observer: IntersectionObserver) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  };

  if ('IntersectionObserver' in window && panels.length) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      panels.forEach((panel) => panel.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver(reveal, {
        rootMargin: '0px 0px -12% 0px',
        threshold: 0.22,
      });
      panels.forEach((panel) => observer.observe(panel));
    }
  } else {
    panels.forEach((panel) => panel.classList.add('is-visible'));
  }
</script>

<style>
  .identity-intro {
    padding-block: clamp(3.5rem, 8vh, 6rem) clamp(1rem, 3vh, 2rem);
  }

  .identity-intro__text {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
  }

  .identity-sequence {
    padding-bottom: var(--space-8);
  }
</style>

<style is:global>
  /* Quiet header over the full-bleed hero; solidifies after scroll */
  body:has(.home) .site-header {
    background: transparent;
    border-bottom-color: transparent;
    backdrop-filter: none;
  }

  body:has(.home) .site-header.is-solid {
    background: color-mix(in srgb, var(--color-bg) 86%, transparent);
    border-bottom-color: var(--color-border);
    backdrop-filter: blur(12px);
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const hero = document.querySelector('.hero');
  if (header instanceof HTMLElement && hero instanceof HTMLElement) {
    const sync = () => {
      header.classList.toggle('is-solid', window.scrollY > hero.offsetHeight - 64);
    };
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }
</script>
