---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCinematic from '../components/HeroCinematic.astro';
import IdentityPanel from '../components/IdentityPanel.astro';

const identities = [
  {
    title: 'Curious.',
    quote: '"I have no special talents. I am only passionately curious." — Albert Einstein',
    body: 'They say curiosity killed the cat, but luckily in tech we have backup servers. Curiosity is the main driver of discovery and learning in my life. It is the reason my interests span so wide across data, machine learning, and the software development lifecycle. When puzzled, I have to dig through the layers until I figure out why it works.',
    image: '/images/atmosphere/astronomy.png',
    imageAlt: 'Night sky and astronomy equipment under stars',
    imagePosition: '50% 38%',
    reverse: false,
  },
  {
    title: 'Accountable.',
    quote: '"The price of greatness is responsibility." — Winston Churchill',
    body: 'Accountability means owning the outcome, not just the effort. The standard I hold myself to is the same one I hope others will adopt; not because I\'ve said it, but because they\'ve seen it.',
    image: '/images/atmosphere/cliff-jump.png',
    imageAlt: 'Person cliff jumping into the ocean',
    imagePosition: '50% 40%',
    reverse: true,
  },
  {
    title: 'Persistent.',
    quote:
      '"I don\'t think you can overstate the amount of discipline and pain tolerance required to build something that lasts." — Jensen Huang',
    body: 'I do not expect rewarding work to feel easy. Anyone can get excited about a brand-new idea, but the real work happens when you hit a brick wall.',
    image: '/images/atmosphere/mountain-explore.png',
    imageAlt: 'Hiker walking a misty mountain path',
    imagePosition: '50% 42%',
    reverse: false,
  },
];
---

<BaseLayout>
  <div class="home">
    <HeroCinematic />

    <div id="identity" class="identity-sequence container-site">
      {
        identities.map((item) => (
          <IdentityPanel
            title={item.title}
            quote={item.quote}
            body={item.body}
            image={item.image}
            imageAlt={item.imageAlt}
            imagePosition={item.imagePosition}
            reverse={item.reverse}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>

<script>
  const panels = document.querySelectorAll('[data-identity-panel]');

  const reveal = (entries: IntersectionObserverEntry[], observer: IntersectionObserver) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  };

  if ('IntersectionObserver' in window && panels.length) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      panels.forEach((panel) => panel.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver(reveal, {
        rootMargin: '0px 0px -12% 0px',
        threshold: 0.22,
      });
      panels.forEach((panel) => observer.observe(panel));
    }
  } else {
    panels.forEach((panel) => panel.classList.add('is-visible'));
  }
</script>

<style>
  .identity-sequence {
    padding-top: clamp(2rem, 5vh, 4rem);
    padding-bottom: var(--space-8);
    scroll-margin-top: 5rem;
  }
</style>

<style is:global>
  /* Quiet header over the full-bleed hero; solidifies after scroll */
  body:has(.home) .site-header {
    background: transparent;
    border-bottom-color: transparent;
    backdrop-filter: none;
  }

  body:has(.home) .site-header.is-solid {
    background: color-mix(in srgb, var(--color-bg) 86%, transparent);
    border-bottom-color: var(--color-border);
    backdrop-filter: blur(12px);
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const hero = document.querySelector('.hero');
  if (header instanceof HTMLElement && hero instanceof HTMLElement) {
    const sync = () => {
      header.classList.toggle('is-solid', window.scrollY > hero.offsetHeight - 64);
    };
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }
</script>
