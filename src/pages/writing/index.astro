---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { site } from '../../data/site';

const entries = (await getCollection('writing')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<BaseLayout
  title={`Writing — ${site.name}`}
  description="A record of stochastic thoughts — postulations, discourses, and working hypotheses."
>
  <section class="writing-page container-site">
    <header class="writing-header">
      <p class="label-mono">Writing</p>
      <h1 class="writing-header__title">A record of stochastic thoughts</h1>
      <p class="writing-header__slogan">Postulations · Discourses · Working Hypotheses</p>
    </header>

    <div class="writing-list">
      {
        entries.map((entry) => (
          <ArticleCard
            title={entry.data.title}
            description={entry.data.description}
            href={`/writing/${entry.id}`}
            date={entry.data.publishedAt.toLocaleDateString('en-GB', {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
            })}
            tags={entry.data.tags}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .writing-page {
    padding-block: var(--space-6) var(--space-9);
  }

  .writing-header {
    max-width: 40rem;
    margin-bottom: var(--space-7);
  }

  .writing-header .label-mono {
    margin-bottom: var(--space-3);
  }

  .writing-header__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--color-text-primary);
  }

  .writing-header__slogan {
    margin: var(--space-3) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    color: var(--color-text-secondary);
  }

  .writing-list {
    max-width: var(--container-max);
  }
</style>
