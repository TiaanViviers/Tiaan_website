---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TextLink from '../../components/TextLink.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, year, category, technologies, links } = project.data;
---

<BaseLayout title={`${title} — ${site.name}`} description={summary}>
  <article class="case-study">
    <header class="case-study__header container-site">
      <p class="label-mono">{category}  /  {year}</p>
      <h1 class="case-study__title">{title}</h1>
      <p class="case-study__summary">{summary}</p>
      {
        technologies.length > 0 && (
          <p class="case-study__themes">{technologies.join('  /  ')}</p>
        )
      }
      {
        links &&
          (links.repository ||
            links.report ||
            links.demo ||
            links.package ||
            links.documentation) && (
          <div class="case-study__links">
            {links.repository && (
              <a href={links.repository} rel="noopener noreferrer" target="_blank">
                Repository
              </a>
            )}
            {links.package && (
              <a href={links.package} rel="noopener noreferrer" target="_blank">
                PyPI
              </a>
            )}
            {links.documentation && (
              <a href={links.documentation} rel="noopener noreferrer" target="_blank">
                Documentation
              </a>
            )}
            {links.report && <a href={links.report}>Report</a>}
            {links.demo && <a href={links.demo}>Demo</a>}
          </div>
        )
      }
    </header>

    <div class="case-study__body container-site">
      <div class="prose-narrow case-study__prose">
        <Content />
      </div>
    </div>

    <div class="case-study__back container-site">
      <TextLink href="/work">Back to work</TextLink>
    </div>
  </article>
</BaseLayout>

<style>
  .case-study {
    padding-block: var(--space-7) var(--space-9);
  }

  .case-study__header {
    max-width: 42rem;
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .case-study__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .case-study__summary {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-body);
    line-height: 1.7;
    max-width: 42rem;
  }

  .case-study__themes {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .case-study__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-2);
  }

  .case-study__links a {
    color: var(--color-text-primary);
    font-size: var(--text-small);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.1rem;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .case-study__links a:hover {
    border-bottom-color: var(--color-text-primary);
  }

  .case-study__prose :global(h2) {
    font-family: var(--font-display);
    font-size: 1.35rem;
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
    line-height: 1.2;
  }

  .case-study__prose :global(h3) {
    font-family: var(--font-display);
    font-size: 1.1rem;
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
    line-height: 1.25;
    color: var(--color-text-primary);
  }

  .case-study__prose :global(p),
  .case-study__prose :global(ul),
  .case-study__prose :global(ol) {
    margin-bottom: var(--space-4);
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    line-height: 1.7;
  }

  .case-study__prose :global(ul),
  .case-study__prose :global(ol) {
    padding-left: 1.25rem;
  }

  .case-study__prose :global(ul) {
    list-style-type: disc;
  }

  .case-study__prose :global(ol) {
    list-style-type: decimal;
  }

  .case-study__prose :global(li) {
    margin-bottom: var(--space-2);
    padding-left: 0.15rem;
  }

  .case-study__prose :global(li::marker) {
    color: var(--color-text-muted);
  }

  .case-study__prose :global(strong) {
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .case-study__prose :global(blockquote) {
    margin: var(--space-5) 0;
    padding-left: var(--space-4);
    border-left: 1px solid var(--color-border-strong);
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.4;
  }

  .case-study__prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-text-primary);
    background: var(--color-surface);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
  }

  .case-study__prose :global(table) {
    width: 100%;
    margin: var(--space-5) 0 var(--space-6);
    border-collapse: collapse;
    font-size: var(--text-small);
  }

  .case-study__prose :global(th),
  .case-study__prose :global(td) {
    padding: 0.65rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .case-study__prose :global(th) {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .case-study__prose :global(td) {
    color: var(--color-text-secondary);
  }

  .case-study__prose :global(th:not(:first-child)),
  .case-study__prose :global(td:not(:first-child)) {
    text-align: right;
  }

  .case-study__prose :global(.katex) {
    color: var(--color-text-primary);
    font-size: 1.05em;
  }

  .case-study__prose :global(.katex-display) {
    margin: var(--space-5) 0;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .case-study__back {
    margin-top: var(--space-8);
  }
</style>
